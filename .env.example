# 复制为 .env 后由 docker compose 读取，并作为环境变量传入容器。
# 容器内不打开 /app/.env；没有这个文件也能启动。
# 不复制时，compose 使用与下面相同的默认连接。留空的变量不会覆盖已有配置。
# 环境变量优先于挂载的配置文件。
# BAIDUBAK_PORT 是面板映射到宿主机 127.0.0.1 的端口。容器内固定监听 8080。
# BAIDUBAK_MYSQL_PORT、BAIDUBAK_REDIS_PORT 是自带 MySQL / Redis 映射到宿主机的端口，只绑定 127.0.0.1。
# 默认通过 host.docker.internal 连接宿主机上的 MySQL / Redis。宿主机映射端口变了，下面的端口也要一起改。
# 启用 compose profile 自带数据库时，改为服务名和容器端口：
#   BAIDUBAK_MYSQL_DSN=root:@tcp(mysql:3306)/yy?charset=utf8mb4&parseTime=True&loc=Local
#   BAIDUBAK_REDIS_HOST=redis:6379

BAIDUBAK_PORT=8080
BAIDUBAK_MYSQL_PORT=3306
BAIDUBAK_REDIS_PORT=6379
BAIDUBAK_MYSQL_DSN=root:@tcp(host.docker.internal:3306)/yy?charset=utf8mb4&parseTime=True&loc=Local
BAIDUBAK_REDIS_HOST=host.docker.internal:6379
BAIDUBAK_REDIS_USER=
BAIDUBAK_REDIS_PASSWORD=
# 登录会话和网盘凭据加密都使用这个密钥。复制到 .env 后自行填写，不要提交真实值。
BAIDUBAK_JWT_SECRET=
